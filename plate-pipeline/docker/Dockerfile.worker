# Dockerfile.worker

FROM python:3.12-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

COPY requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

FROM python:3.12-slim AS runtime

LABEL maintainer="plate-pipeline"
LABEL description="License Plate Detection — Celery Worker"

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

COPY --from=builder /install /usr/local

RUN groupadd -r worker && useradd -r -g worker worker

WORKDIR /app

COPY config/      config/
COPY dspy_module/ dspy_module/
COPY services/    services/
COPY main.py      .

RUN mkdir -p /tmp/plate-pipeline/frames /models \
    && chown -R worker:worker /app /tmp/plate-pipeline

COPY --chown=worker:worker models/ /models/

USER worker

HEALTHCHECK --interval=30s --timeout=15s --start-period=20s --retries=3 \
    CMD celery -A services.worker inspect ping --destination celery@$HOSTNAME \
        --timeout 10 || exit 1

CMD ["celery", \
     "-A", "services.worker", \
     "worker", \
     "--loglevel=warning", \
     "--concurrency=4", \
     "--prefetch-multiplier=1", \
     "--max-tasks-per-child=500", \
     "--without-gossip", \
     "--without-mingle", \
     "--without-heartbeat"]