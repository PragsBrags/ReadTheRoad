# Dockerfile.api 


FROM python:3.12-slim AS builder


RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build


COPY requirements.txt .
RUN pip install --no-cache-dir --prefix=/install \
    --index-url https://download.pytorch.org/whl/cpu \
    --extra-index-url https://pypi.org/simple \
    torch torchvision \
    -r requirements.txt



FROM python:3.12-slim AS runtime

LABEL maintainer="plate-pipeline"
LABEL description="License Plate Detection — Ingestion API"

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libgomp1 \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean


COPY --from=builder /install /usr/local

RUN groupadd -r appuser && useradd -r -g appuser appuser

WORKDIR /app


COPY config/      config/
COPY dspy_module/ dspy_module/
COPY services/    services/
COPY main.py      .


RUN mkdir -p \
        /home/appuser \
        /tmp/plate-pipeline/uploads \
        /tmp/plate-pipeline/frames \
        /models \
        /tmp/ocr-models \
        /tmp/fontconfig \
    && chown -R appuser:appuser /home/appuser /app /tmp/plate-pipeline /models /tmp/ocr-models /tmp/fontconfig


COPY --chown=appuser:appuser models/ /models/

USER appuser


HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f --silent --max-time 5 http://localhost:8000/status || exit 1

EXPOSE 8000


CMD ["uvicorn", "main:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--workers", "4", \
     "--loop", "uvloop", \
     "--http", "httptools", \
     "--no-access-log"]